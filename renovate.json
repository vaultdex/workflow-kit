{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "automerge": false,
  "git-submodules": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        ".vendor/impeccable"
      ],
      "versioning": "regex:^skill-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "postUpgradeTasks": {
        "commands": ["node scripts/update-impeccable.mjs"],
        "executionMode": "branch",
        "fileFilters": [
          "scripts/impeccable/**",
          "docs/impeccable.md",
          "templates/.codex/hooks.json", "templates/.claude/settings.json", "templates/.github/hooks/impeccable.json",
          ".codex/hooks.json", ".claude/settings.json", ".github/hooks/impeccable.json",
          ".agent/skills/impeccable/**", ".agents/skills/impeccable/**", ".claude/skills/impeccable/**",
          ".github/skills/impeccable/**", ".opencode/skills/impeccable/**", ".pi/skills/impeccable/**",
          ".codex/agents/impeccable*", ".claude/agents/impeccable*", ".github/agents/impeccable*", ".opencode/commands/impeccable*"
        ]
      }
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "matchDepNames": [
        ".vendor/ponytail"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Renovate regenerate holds contents: write; its action pins stay full commit SHAs with a version comment and need human review before merge.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/renovate-regenerate.yml"],
      "pinDigests": true,
      "automerge": false
    }
  ]
}
